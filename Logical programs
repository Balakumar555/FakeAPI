    public static void ReverseNumber(int number)
    {
        int reverseNumber = 0;
        int lastDigit = 0;
        while (number > 0)
        {
            lastDigit = number % 10;
            reverseNumber = (reverseNumber * 10) + lastDigit;

            number = number / 10;
        }
        Console.Write(reverseNumber);
    }
